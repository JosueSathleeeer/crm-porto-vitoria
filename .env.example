# Copie para .env e ajuste
PORT=3000
# Troque por uma frase longa e aleatória (obrigatório em produção)
JWT_SECRET=troque-esta-frase-por-algo-longo-e-aleatorio
# Validade da sessão em horas
SESSAO_HORAS=12
# Pasta do banco de dados (arquivo SQLite)
DATA_DIR=./data
# Usuário administrador criado no primeiro uso
ADMIN_LOGIN=igor
ADMIN_SENHA=porto2026
ADMIN_NOME=Igor Sathler
# Em produção com HTTPS, deixe true (cookie seguro)
COOKIE_SECURE=false
